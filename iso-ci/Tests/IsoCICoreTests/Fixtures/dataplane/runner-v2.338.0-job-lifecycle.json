{
  "description": "One ephemeral official-runner job over the run-service flavour, replayed against the endpoint router. Request shapes are derived by reading actions/runner v2.338.0 (MIT): BrokerHttpClient.cs (session/message), TaskAgentSession.cs, RunServiceHttpClient.cs + Contracts/AcquireJobRequest.cs, RenewJobRequest.cs, CompleteJobRequest.cs, StepResult.cs, ResultsHttpClient.cs + Contracts.cs (snake_case results receiver), and the step-update conversion in ResultsHttpClient.ConvertTimelineRecordToStep. Placeholders ${...} are substituted by the replay test. Not captured from a live runner.",
  "runner_version": "2.338.0",
  "source": "https://github.com/actions/runner/tree/v2.338.0 (commit 197ca027b90de199464dee3bb9ff198a1db60967)",
  "steps": [
    {"name": "create broker session", "auth": "runner", "method": "POST", "path": "/broker/session",
     "body": {"sessionId": "00000000-0000-0000-0000-000000000000", "ownerName": "", "agent": {"id": 1, "name": "iso-ci-runner", "version": "2.338.0", "osDescription": "Ubuntu 24.04"}, "useFipsEncryption": false, "brokerSession": true},
     "expect": {"status": 200, "keys": ["sessionId", "agent"]}, "capture": {"SESSION_ID": "sessionId"}},
    {"name": "second session conflicts", "auth": "runner", "method": "POST", "path": "/broker/session",
     "body": {"agent": {"id": 1, "name": "x"}}, "expect": {"status": 409}},
    {"name": "poll message", "auth": "runner", "method": "GET",
     "path": "/broker/message?sessionId=${SESSION_ID}&status=Online&runnerVersion=2.338.0&os=Linux&architecture=ARM64&disableUpdate=true",
     "expect": {"status": 200, "equals": {"messageType": "RunnerJobRequest"}}},
    {"name": "acquire job", "auth": "runner", "method": "POST", "path": "/run/acquirejob",
     "body": {"jobMessageId": "${JOB_ID}", "runnerOS": "Linux", "billingOwnerId": ""},
     "expect": {"status": 200, "equals": {"messageType": "RunnerJobRequest", "jobId": "${JOB_ID}"}, "keys": ["steps", "resources", "contextData", "variables"]}},
    {"name": "second acquire conflicts", "auth": "runner", "method": "POST", "path": "/run/acquirejob",
     "body": {"jobMessageId": "${JOB_ID}", "runnerOS": "Linux"}, "expect": {"status": 409}},
    {"name": "renew job", "auth": "job", "method": "POST", "path": "/run/renewjob",
     "body": {"planId": "${PLAN_ID}", "jobId": "${JOB_ID}"}, "expect": {"status": 200, "keys": ["lockedUntil"]}},
    {"name": "step update", "auth": "job", "method": "POST",
     "path": "/twirp/github.actions.results.api.v1.WorkflowStepUpdateService/WorkflowStepsUpdate",
     "body": {"steps": [{"external_id": "6f0f5c8e-1c11-4c1b-9a3e-2b2d3f1e0a01", "number": 1, "name": "Run echo hi", "status": 6, "started_at": "2026-10-19T00:00:00.000Z", "completed_at": "2026-10-19T00:00:01.000Z", "conclusion": 2}], "change_order": 1, "workflow_job_run_backend_id": "${JOB_ID}", "workflow_run_backend_id": "${PLAN_ID}"},
     "expect": {"status": 200, "equals": {"ok": true}}},
    {"name": "job log url", "auth": "job", "method": "POST",
     "path": "/twirp/results.services.receiver.Receiver/GetJobLogsSignedBlobURL",
     "body": {"workflow_job_run_backend_id": "${JOB_ID}", "workflow_run_backend_id": "${PLAN_ID}"},
     "expect": {"status": 200, "equals": {"blob_storage_type": "BLOB_STORAGE_TYPE_UNSPECIFIED"}, "keys": ["logs_url"]}, "capture_url": {"JOB_LOG_URL": "logs_url"}},
    {"name": "job log wrong backend ids", "auth": "job", "method": "POST",
     "path": "/twirp/results.services.receiver.Receiver/GetJobLogsSignedBlobURL",
     "body": {"workflow_job_run_backend_id": "00000000-0000-0000-0000-000000000001", "workflow_run_backend_id": "${PLAN_ID}"},
     "expect": {"status": 403}},
    {"name": "job log upload (single block)", "auth": "none", "method": "PUT", "path": "${JOB_LOG_URL}",
     "raw_body": "line one\nline two\n", "headers": {"Content-Type": "text/plain"}, "expect": {"status": 201}},
    {"name": "job log metadata", "auth": "job", "method": "POST",
     "path": "/twirp/results.services.receiver.Receiver/CreateJobLogsMetadata",
     "body": {"workflow_job_run_backend_id": "${JOB_ID}", "workflow_run_backend_id": "${PLAN_ID}", "uploaded_at": "2026-10-19T00:00:02.000Z", "line_count": 2},
     "expect": {"status": 200, "equals": {"ok": true}}},
    {"name": "complete job", "auth": "job", "method": "POST", "path": "/run/completejob",
     "body": {"planId": "${PLAN_ID}", "jobId": "${JOB_ID}", "conclusion": "succeeded", "outputs": {"version": {"value": "1.2.3", "isSecret": false}}, "stepResults": [{"external_id": "6f0f5c8e-1c11-4c1b-9a3e-2b2d3f1e0a01", "number": 1, "name": "Run echo hi", "type": "run", "status": 2, "conclusion": "succeeded"}], "annotations": []},
     "expect": {"status": 200}},
    {"name": "delete session", "auth": "runner", "method": "DELETE", "path": "/broker/session?sessionId=${SESSION_ID}",
     "expect": {"status": 200}}
  ]
}
