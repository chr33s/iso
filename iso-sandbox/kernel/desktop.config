# Options iso's desktop kernel adds to apple/containerization 0.54.0's
# kernel/config-arm64 (docs/design/linux-desktop-virtio-gpu.md §5): the
# virtio-gpu display and the USB keyboard and pointer VZ attaches to a
# sandbox created with `--display virtio`. scripts/build-desktop-kernel.sh
# applies them and fails if `olddefconfig` drops any.
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
