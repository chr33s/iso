#!/usr/bin/python3
"""Stand-in for Apple `container` used only by the lifecycle differential
test: records argv, captures each build context, and exports a JSON "tar"
naming the image so the fake runtime can import it."""
import json
import os
import shutil
import sys

HERE = os.path.dirname(os.path.abspath(__file__))


def main():
    argv = sys.argv[1:]
    with open(os.path.join(HERE, "calls.log"), "a") as handle:
        handle.write(json.dumps(["container"] + argv) + "\n")
    if argv[:2] == ["system", "status"]:
        return
    if argv[:1] == ["build"]:
        reference = argv[argv.index("-t") + 1]
        context = argv[-1]
        kind = "maintenance" if "-maintenance:" in reference else "image"
        target = os.path.join(HERE, "contexts", kind)
        shutil.rmtree(target, ignore_errors=True)
        shutil.copytree(context, target)
        print("building " + reference)
        return
    if argv[:2] == ["image", "save"]:
        tar = argv[argv.index("-o") + 1]
        with open(tar, "w") as handle:
            json.dump({"reference": argv[-1]}, handle)
        return
    if argv[:2] == ["image", "delete"]:
        return
    print("unexpected: " + " ".join(argv), file=sys.stderr)
    sys.exit(64)


if __name__ == "__main__":
    main()
