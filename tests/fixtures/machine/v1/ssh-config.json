{
  "api_version": "iso.machine/v1",
  "command": "ssh-config",
  "ok": true,
  "result": {
    "instance": {
      "name": "my-project",
      "state": "running",
      "image": "default",
      "backend": "apple-container"
    },
    "connection": {
      "kind": "ssh",
      "host_alias": "iso-my-project",
      "ssh_config_path": "/Users/me/.ssh/config"
    }
  }
}
