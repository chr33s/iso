{
  "data_dir": "/home/fixture/state/iso",
  "vm": {
    "vcpu_count": 8,
    "mem_size_mib": 8192,
    "kernel_path": "/home/fixture/.iso/vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off root=/dev/vda rw",
    "template_size_gib": 32
  },
  "network": {
    "host_ip": "172.16.0.1",
    "subnet_mask": "/24",
    "host_iface": "auto"
  },
  "ssh_port": 2222,
  "firecracker_bin": "/home/fixture/.iso/firecracker",
  "github": {
    "mode": "pat",
    "pat": {
      "other/re.po": {
        "token": "github_pat_SYNTHETIC_NOT_A_TOKEN"
      },
      "owner/repo": {
        "token": "cmd:security find-generic-password -s coop-github-pat -a owner-repo -w"
      }
    },
    "skip": [
      "owner/big-repo"
    ]
  },
  "setup": {
    "prompt_for_pat": false
  },
  "claude": {
    "api_key": "cmd:security find-generic-password -s anthropic -w",
    "env_forward": [
      "CUSTOM_TOKEN",
      "_OTHER"
    ],
    "marketplaces": [
      "https://github.com/anthropics/claude-plugins-official",
      "/home/fixture/local/market"
    ],
    "plugins": [
      "rust-analyzer-lsp@claude-plugins-official"
    ],
    "mcp_servers": {
      "events": {
        "type": "sse",
        "url": "https://sse.example.com/stream"
      },
      "dotted.name": {
        "type": "http",
        "url": "https://mcp.example.com/v1/",
        "headers": {
          "Authorization": "cmd:echo synthetic-header"
        }
      },
      "stdio-server": {
        "command": "/usr/bin/my-mcp-server",
        "args": [
          "--verbose"
        ],
        "env": {
          "API_KEY": "MY_HOST_ENV_VAR"
        }
      }
    },
    "config_dir": false,
    "local_model": {
      "host_url": "http://localhost:11434/",
      "model": "qwen2.5-coder:32b",
      "auth_token": "synthetic-local-token"
    }
  },
  "codex": {
    "auth": "chatgpt",
    "api_key": null,
    "env_forward": [],
    "marketplaces": [
      "trailofbits/codex-plugins"
    ],
    "plugins": [],
    "mcp_servers": {},
    "config_dir": "/home/fixture/codex-config",
    "local_model": {
      "host_url": "http://localhost:11434/v1/",
      "model": "gpt-oss:120b",
      "auth_token": null
    }
  },
  "proxy": {
    "anthropic": {
      "credential": "cmd:security find-generic-password -s coop-anthropic -a anthropic -w",
      "auth": "bearer"
    },
    "openai": null
  },
  "guest_env": {
    "RUST_LOG": "info",
    "Z9": "last",
    "_UNDERSCORE": ""
  },
  "profiles": {
    "a": {
      "apt_packages": [],
      "pre_install": null,
      "post_install": null,
      "marketplaces": [
        "/home/fixture/nested"
      ],
      "plugins": []
    },
    "a.b": {
      "apt_packages": [],
      "pre_install": null,
      "post_install": null,
      "marketplaces": [],
      "plugins": [
        "dotted@profile"
      ]
    },
    "my-tools": {
      "apt_packages": [
        "ripgrep",
        "fd-find",
        "jq"
      ],
      "pre_install": "curl -fsSL https://example.com/setup.sh | bash",
      "post_install": "echo done",
      "marketplaces": [],
      "plugins": []
    }
  },
  "post_start": "make dev-setup",
  "forward_ports": [
    {
      "guest": 3000
    },
    {
      "guest": 8080,
      "host": 18080
    },
    {
      "guest": 9000
    },
    {
      "guest": 5432,
      "label": "db"
    },
    {
      "guest": 6000,
      "host": 6001
    }
  ],
  "updates": {
    "mode": "off",
    "check_interval_hours": 168
  },
  "apple_container": {
    "binary": "/opt/iso/bin/iso-sandbox",
    "builder": "/home/fixture/bin/container",
    "kernel": "/opt/iso/vmlinux",
    "probe_timeout_seconds": 5,
    "operation_timeout_seconds": 30,
    "create_timeout_seconds": 900,
    "boot_timeout_seconds": 240,
    "stop_timeout_seconds": 45,
    "build_timeout_seconds": 86400
  }
}
